# 测试夹具:金字塔(vn)+ 贴图四边形(无 vn,几何法线)
# 覆盖四种索引形态(v、v/vt、v//vn、v/vt/vn)、负索引、四边形扇形三角化、
# 注释行与未知指令忽略。索引 1 基,负索引相对末尾。
o fixture
mtllib none.mtl
usemtl none
s off

v -0.5 0 -0.5
v 0.5 0 -0.5
v 0.5 0 0.5
v -0.5 0 0.5
v 0 1 0

vn 0 -1 0
vn 0.894 0.447 0
vn -0.894 0.447 0
vn 0 0.447 0.894
vn 0 0.447 -0.894

vt 0 0
vt 1 0
vt 1 1
vt 0 1

# 底面(v//vn 形态,四边形)
f 1//1 2//1 3//1 4//1
# 侧面(v/vt/vn 形态,含负索引 -1 = 第 5 顶点)
f 2/2/2 1/3/2 -1/4/2
f 3/2/5 2/3/5 -1/4/5
f 4/2/4 3/3/4 -1/4/4
f 1/2/3 4/3/3 -1/4/3

# 贴图四边形(v/vt 形态,无 vn → 几何法线)
v -1.6 -0.5 1.2
v -0.2 -0.5 1.2
v -0.2 0.7 1.2
v -1.6 0.7 1.2

f 6/1 7/2 8/3
f 6/1 8/3 9/4
